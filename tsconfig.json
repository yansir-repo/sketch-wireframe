{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "sketch-wireframe": ["./src/shared/dsl.ts"]
    }
  },
  "include": ["vite.config.ts", "examples/**/*.ts"]
}
