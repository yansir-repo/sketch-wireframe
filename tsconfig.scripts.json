{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "sketch-wireframe": ["./src/shared/dsl.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "src/shared/**/*.ts", "examples/**/*.ts"]
}
