  "header": {
    "group": [
      {
        "slot": "image",
        "fill": "LOGO"
      },
      {
        "slot": "nav",
        "paths": ["/", "/category", "/product", "/inquiry"]
      },
      {
        "slot": "action",
        "fill": "获取报价",
        "to": "/inquiry"
      }
    ],
    "dir": "row"
  },
  "footer": {
    "group": [
      {
        "slot": "text",
        "size": 3,
        "fill": "联系方式"
      },
      {
        "slot": "text",
        "size": 3,
        "fill": "版权"
      }
    ],
    "dir": "row"
  },
  "pages": {
    "/": {
      "name": "首页",
      "body": [
        {
          "group": [
            {
              "group": [
                {
                  "group": [
                    {
                      "slot": "text",
                      "size": 1
                    },
                    {
                      "slot": "text",
                      "size": 2
                    },
                    {
                      "group": [
                        {
                          "slot": "action",
                          "fill": "获取报价",
                          "to": "/inquiry"
                        },
                        {
                          "slot": "action",
                          "fill": "查看产品",
                          "to": "/category",
                          "ghost": true
                        }
                      ],
                      "dir": "row"
                    }
                  ],
                  "dir": "col"
                },
                {
                  "slot": "image"
                }
              ],
              "dir": "row"
            }
          ],
          "dir": "col",
          "name": "Hero"
        },
        {
          "group": [
            {
              "slot": "collection",
              "type": "category",
              "limit": 8
            }
          ],
          "dir": "col",
          "name": "产品分类入口"
        },
        {
          "group": [
            {
              "slot": "collection",
              "type": "product",
              "limit": 4
            }
          ],
          "dir": "col",
          "name": "热门型号"
        }
      ]
    },
    "/category/:id": {
      "ctx": {
        "type": "product",
        "many": true,
        "where": {
          "category": ":id"
        }
      },
      "body": [
        {
          "group": [
            {
              "group": [
                {
                  "slot": "filters",
                  "fields": ["materials", "certs"],
                  "w": 1
                },
                {
                  "slot": "collection",
                  "type": "product",
                  "where": {
                    "category": ":id"
                  },
                  "limit": 24,
                  "w": 3
                }
              ],
              "dir": "row"
            }
          ],
          "dir": "col",
          "name": "产品"
        }
      ]
    },
    "/product": {
      "name": "全部型号",
      "ctx": {
        "type": "product",
        "many": true
      },
      "body": [
        {
          "group": [
            {
              "group": [
                {
                  "slot": "filters",
                  "fields": ["category", "materials", "certs"],
                  "w": 1
                },
                {
                  "slot": "collection",
                  "type": "product",
                  "limit": 60,
                  "w": 3
                }
              ],
              "dir": "row"
            }
          ],
          "dir": "col",
          "name": "产品"
        }
      ]
    },
    "/product/:id": {
      "ctx": {
        "type": "product"
      },
      "body": [
        {
          "group": [
            {
              "slot": "gallery",
              "field": "photos"
            }
          ],
          "dir": "col",
          "name": "图库"
        },
        {
          "group": [
            {
              "slot": "text",
              "size": 1,
              "fill": {
                "bind": "code"
              }
            },
            {
              "slot": "facts"
            }
          ],
          "dir": "col",
          "name": "基本信息"
        },
        {
          "group": [
            {
              "group": [
                {
                  "slot": "badges",
                  "field": "certs"
                },
                {
                  "slot": "action",
                  "fill": "获取报价",
                  "to": "/inquiry"
                }
              ],
              "dir": "row"
            }
          ],
          "dir": "col",
          "name": "认证与报价"
        },
        {
          "group": [
            {
              "slot": "collection",
              "type": "product",
              "where": {
                "category": "$category"
              },
              "limit": 4,
              "notSelf": true
            }
          ],
          "dir": "col",
          "name": "同类型号"
        }
      ]
    },
    "/inquiry": {
      "name": "获取报价",
      "ctx": {
        "type": "inquiry",
        "create": true
      },
      "body": [
        {
          "group": [
            {
              "slot": "form"
            }
          ],
          "dir": "col",
          "name": "表单"
        }
      ]
    }
  }
}
