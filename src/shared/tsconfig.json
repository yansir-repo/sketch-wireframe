{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "paths": {
      "sketch-wireframe": ["./dsl.ts"]
    }
  },
  "include": ["**/*.ts", "../../examples/**/*.ts"]
}
