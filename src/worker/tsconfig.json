{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "sketch-wireframe": ["../shared/dsl.ts"]
    }
  },
  "include": ["**/*.ts", "../shared/**/*.ts", "../../examples/**/*.ts"],
  "exclude": ["../shared/**/*.test.ts", "test/**"]
}
